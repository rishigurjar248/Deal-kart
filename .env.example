# Existing secure admin login
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Supabase server-side credentials (never expose the secret key in frontend code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
