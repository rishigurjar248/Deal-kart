# Server-side admin authentication. NEVER expose these as VITE_* variables.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Server-side Supabase credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public browser-side Supabase credentials. These are safe to expose in Vercel's frontend build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# YouPI-PG server-side payment integration. Never use VITE_ prefixes for these.
# Base URL must be the public HTTPS gateway origin that routes /api/v1/payments to the payment API.
YOUPI_API_URL=https://your-public-youpi-payment-api-url
YOUPI_MERCHANT_ID=your-youpi-merchant-uuid
YOUPI_MERCHANT_API_KEY=your-rotated-merchant-api-key
YOUPI_WEBHOOK_SECRET=your-rotated-youpi-webhook-secret
# Public origin of DealKart, without a trailing slash.
DEALKART_PUBLIC_URL=https://your-deployed-dealkart-domain
